{
	"extends": ["config:base"],
	"baseBranches": ["master"],
	"autodiscover": false,
	"repositories": ["Venatum/bull-board-docker", "Venatum/docker-arena"],
	"labels": ["dependencies"],
	"assignAutomerge": true,
	"assignees": ["Venatum"],
	"automerge": false,
	"automergeStrategy": "merge-commit",
	"automergeType": "pr",
	"ignoreTests": true,
	"rebaseWhen": "conflicted",
	"semanticCommitScope": "deps",
	"packageRules": [
		{
			"packageNames": ["semantic-release"],
			"matchPackagePatterns": ["^@semantic-release/"],
			"semanticCommitType": "ci",
			"semanticCommitScope": "semantic-release",
			"automerge": true
		},
		{
			"matchManagers": ["github-actions"],
			"semanticCommitType": "ci",
			"semanticCommitScope": "actions",
			"automerge": true
		},
		{
			"matchDepTypes": ["dependencies"],
			"semanticCommitType": "chore",
			"semanticCommitScope": "deps"
		},
		{
			"depTypeList": ["devDependencies"],
			"semanticCommitType": "chore",
			"semanticCommitScope": "dev-deps",
			"automerge": true
		},
		{
			"matchDatasources": ["docker"],
			"semanticCommitType": "build",
			"semanticCommitScope": "docker"
		},
		{
			"description": "Pin conventional-changelog-conventionalcommits to v9: v10 requires conventional-changelog-writer@9, but semantic-release@25's release-notes-generator@14 is locked to writer@8. Re-allow once release-notes-generator@15 ships.",
			"matchPackageNames": ["conventional-changelog-conventionalcommits"],
			"allowedVersions": "<10"
		}
	]
}
